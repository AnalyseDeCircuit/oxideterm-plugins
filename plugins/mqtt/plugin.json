              "kind": "text",
              "id": "host",
              "label": "@mqtt.host",
              "value": "localhost"
            },
            {
              "kind": "number",
              "id": "port",
              "label": "@mqtt.port",
              "min": 1,
              "max": 65535
            },
            {
              "kind": "checkbox",
              "id": "tls",
              "label": "@mqtt.tls",
              "value": false
            },
            {
              "kind": "textarea",
              "id": "ca_pem",
              "label": "@mqtt.ca_pem"
            },
            {
              "kind": "text",
              "id": "username",
              "label": "@mqtt.username"
            },
            {
              "kind": "password",
              "id": "password",
              "label": "@mqtt.password"
            },
            {
              "kind": "text",
              "id": "client_id",
              "label": "@mqtt.client_id"
            },
            {
              "kind": "number",
              "id": "keep_alive",
              "label": "@mqtt.keep_alive",
              "value": 30,
              "min": 5,
              "max": 65535
            },
            {
              "kind": "checkbox",
