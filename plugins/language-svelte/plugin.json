{
  "id": "com.oxideterm.language.svelte",
  "name": "Svelte Language Support",
  "version": "0.1.0",
  "description": "Svelte template highlighting with bundled JavaScript, TypeScript and CSS support.",
  "author": "OxideTerm",
  "repository": "https://github.com/AnalyseDeCircuit/oxideterm-plugins/tree/main/plugins/language-svelte",
  "runtime": {
    "kind": "language",
    "entry": "parser.wasm"
  },
  "contributes": {
    "language": {
      "id": "svelte",
      "displayName": "Svelte",
      "grammarName": "svelte",
      "extensions": [
        "svelte"
      ],
      "highlights": "highlights.scm"
    }
  },
  "engines": {
    "oxideterm": ">=2.2.2"
  },
  "license": "Apache-2.0"
}
