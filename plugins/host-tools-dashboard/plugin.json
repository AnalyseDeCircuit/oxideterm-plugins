{
  "id": "com.oxideterm.examples.host-tools-dashboard",
  "name": "Workspace Dashboard",
  "version": "0.4.1",
  "license": "GPL-3.0-only",
  "author": "AnalyseDeCircuit",
  "description": "Continue recent work, follow active tasks, and handle workspace issues in one place.",
  "runtime": {
    "kind": "process",
    "entry": "bin/host-tools-dashboard.js"
  },
  "permissions": {
    "capabilities": [
      "ui.write",
      "sessions.read",
      "connections.control",
      "transfers.read",
      "plugin.settings.write"
    ]
  },
  "contributes": {
    "activityBarItems": [
      {
        "id": "dashboard",
        "title": "Workspace Dashboard",
        "icon": "layout-dashboard",
        "command": "dashboard.open",
        "position": "top"
      }
    ],
    "tabs": [
      {
        "id": "dashboard",
        "title": "Workspace Dashboard",
        "icon": "layout-dashboard"
      }
    ]
  },
  "engines": {
    "oxideterm": ">2.2.0"
  }
}
