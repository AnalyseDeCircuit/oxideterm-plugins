{
  "id": "com.oxideterm.language.ini",
  "name": "INI Language Support",
  "version": "0.1.0",
  "description": "Syntax highlighting for INI files.",
  "author": "OxideTerm",
  "repository": "https://github.com/AnalyseDeCircuit/oxideterm-plugins/tree/main/plugins/language-ini",
  "runtime": {
    "kind": "language",
    "entry": "parser.wasm"
  },
  "contributes": {
    "language": {
      "id": "ini",
      "displayName": "INI",
      "grammarName": "ini",
      "extensions": [
        "ini"
      ],
      "fileNames": [
        ".editorconfig",
        ".gitconfig"
      ],
      "highlights": "highlights.scm"
    }
  },
  "engines": {
    "oxideterm": ">=2.2.2"
  },
  "license": "Apache-2.0"
}
